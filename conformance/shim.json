    {
      "name": "appStatus with the app stopped is answered by the shim",
      "app": "stopped",
      "request": {
        "v": 9,
        "id": "01234567-89ab-4def-8123-456789abcdef",
        "method": "appStatus"
      },
      "launches": 0,
      "response": {
        "v": 9,
        "id": "01234567-89ab-4def-8123-456789abcdef",
        "ok": true,
        "app": {
          "running": false,
          "version": null,
          "startAtLogin": "off"
        },
        "shim": {
          "version": "{{version}}"
        }
      }
    },
